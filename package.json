{
  "name": "@wgtechlabs/rove",
  "version": "0.1.0",
  "private": true,
  "description": "A web-first, company-neutral AI agent foundation.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && node --test dist/test/*.test.js test/*.test.mjs",
    "start": "node dist/src/server.js",
    "check": "biome ci . --error-on-warnings",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "better-auth": "1.7.6",
    "pg": "8.23.1",
    "railway": "3.12.0",
    "redis": "6.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  },
  "license": "GPL-3.0-only"
}
