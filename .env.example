# Exact public origin, no trailing slash. HTTPS except local development.
ROVE_URL=http://localhost:3000
# Generate two DIFFERENT random secrets, each at least 32 characters.
BETTER_AUTH_SECRET=
ROVE_SETUP_SECRET=
# Container default: /data/rove.sqlite. Mount a persistent volume at /data.
ROVE_DATABASE_PATH=./data/rove.sqlite
PORT=3000
# Optional Railway Sandbox administration. Web chat does not require these.
# RAILWAY_ENVIRONMENT_ID is automatic on Railway; local smoke tests must supply it.
# Optional offline execution; each call verifies isolation. Live Railway compatibility is unverified.
# RAILWAY_API_TOKEN=
# RAILWAY_TOKEN=
# If both token variables exist, explicitly select bearer or project-token.
# ROVE_RAILWAY_AUTH_TYPE=bearer
# Dedicated smoke environment, if different from the core deployment:
# ROVE_SANDBOX_ENVIRONMENT_ID=
# Bind only explicitly selected plugin secrets from this prefix:
# ROVE_PLUGIN_SECRET_KNOWLEDGE=
